#########################################
# COFFEECOUNTER — configuration
#########################################

#########################################
# SERVER
#########################################
# Base URL — the address you use to reach CoffeeCounter.
# Must match the external port from docker-compose.yml (default 3800).
# NOTE: Passkeys/WebAuthn only work over HTTPS or on localhost in the browser.
BASE_URL=http://192.168.1.50:3800/

# Timezone for aggregation & display (used for the Day/Week/Month/... charts)
TZ=Europe/Berlin

#########################################
# AUTH
#########################################
# 'pin', 'passkey', or 'both' (default: both — PIN as fallback when you
# don't have your passkey with you)
COFFEECOUNTER_AUTH_MODE=both

# Every user's PIN must be exactly this many digits (4-10). One shared
# length for the whole system, since login has no username field — the
# login screen shows this many boxes and matches whichever user it is.
COFFEECOUNTER_PIN_LENGTH=4

# Session length in seconds (default 28800 = 8 hours).
# "instant" or 0 = session cookie only, lost when the browser closes.
SESSION_TIMEOUT=28800

# WebAuthn Relying Party ID — usually leave empty, it's derived from
# BASE_URL's hostname. Set explicitly if your domain differs from
# what browsers see (e.g. behind Cloudflare with a custom hostname).
# COFFEECOUNTER_RP_ID=coffeecounter.example.com

#########################################
# REVERSE PROXY / CLOUDFLARE
#########################################
# Trust proxy headers (X-Forwarded-For, CF-Connecting-IP).
# REQUIRED when running behind your reverse-proxy container / Cloudflare
# Tunnel so the app logs and rate-limits the real client IP, not the
# proxy's IP.
TRUST_PROXY=true

# Prefer Cloudflare's CF-Connecting-IP header over X-Forwarded-For when
# both are present (recommended when Cloudflare sits in front of the proxy).
USE_CF_CONNECTING_IP=true

# Optional: comma-separated list of IPs allowed to set forwarded-for
# headers (your reverse-proxy container's IP). Leave empty to trust any
# peer — fine on an internal Docker network, tighten if exposed directly.
# TRUSTED_PROXY_IPS=172.18.0.1

# Comma-separated list of allowed CORS origins. Leave empty to allow all
# (fine for same-origin use through your reverse proxy).
# ALLOWED_ORIGINS=https://coffeecounter.example.com

#########################################
# WEBHOOK
#########################################
# Optional debounce window in seconds against accidental double-triggers.
# 0 = off (recommended — triggers aren't frequent enough to need this).
WEBHOOK_DEBOUNCE=0

#########################################
# UNRAID / DOCKER VOLUME PATH
#########################################
# Host path for the SQLite DB — classic Unraid appdata folder.
APP_DATA_PATH=/mnt/user/appdata/coffeecounter
